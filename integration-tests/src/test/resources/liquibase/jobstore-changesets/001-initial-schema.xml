<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="job-store-001" author="Tech Pod"
               logicalFilePath="001-initial-schema.xml">
        <preConditions>
            <dbms type="h2"/>
        </preConditions>
        <createTable tableName="jobs">
            <column name="job_id" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="worker_id" type="UUID"/>
            <column name="worker_lock_time" type="TIMESTAMP"/>
            <column name="assigned_task_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_task_start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="job_data" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="retry_attempts_remaining" type="INT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INT" defaultValue="10">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
